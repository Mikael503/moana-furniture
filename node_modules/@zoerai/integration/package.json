{
  "name": "@zoerai/integration",
  "version": "0.0.8",
  "description": "A TypeScript library built with tsdown",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "typescript",
    "library",
    "tsdown"
  ],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.15.6",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
